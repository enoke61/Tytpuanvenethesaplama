<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp"
    android:background="#f5f5f5">

    <TextView
        android:id="@+id/tvHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="TYT Net ve Puan Hesaplama"
        android:textSize="14sp"
        android:textStyle="bold"
        android:gravity="center"
        android:paddingBottom="8dp"
        android:textColor="@android:color/black" />

    <EditText
        android:id="@+id/isim"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Ad"
        android:padding="6dp"
        android:background="@android:drawable/edit_text"
        android:textSize="10sp" />

    <EditText
        android:id="@+id/soyisim"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Soyad"
        android:padding="6dp"
        android:background="@android:drawable/edit_text"
        android:textSize="10sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="6dp"
        android:paddingBottom="4dp"
        android:text=" Türkçe  "
        android:textSize="12sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/turkceD"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Türkçe Doğru"
        android:inputType="number"
        android:padding="6dp"
        android:background="@android:drawable/edit_text"
        android:textSize="10sp" />

    <EditText
        android:id="@+id/turkceY"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Türkçe Yanlış"
        android:inputType="number"
        android:padding="6dp"
        android:background="@android:drawable/edit_text"
        android:textSize="10sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Matematik"
        android:textSize="12sp"
        android:textStyle="bold"
        android:paddingTop="6dp"
        android:paddingBottom="4dp" />

    <EditText
        android:id="@+id/matematikD"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Matematik Doğru"
        android:inputType="number"
        android:padding="6dp"
        android:background="@android:drawable/edit_text"
        android:textSize="10sp" />

    <EditText
        android:id="@+id/matematikY"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Matematik Yanlış"
        android:inputType="number"
        android:padding="6dp"
        android:background="@android:drawable/edit_text"
        android:textSize="10sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Sosyal"
        android:textSize="12sp"
        android:textStyle="bold"
        android:paddingTop="6dp"
        android:paddingBottom="4dp" />

    <EditText
        android:id="@+id/sosyalD"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Sosyal Doğru"
        android:inputType="number"
        android:padding="6dp"
        android:background="@android:drawable/edit_text"
        android:textSize="10sp" />

    <EditText
        android:id="@+id/sosyalY"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Sosyal Yanlış"
        android:inputType="number"
        android:padding="6dp"
        android:background="@android:drawable/edit_text"
        android:textSize="10sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Fen"
        android:textSize="12sp"
        android:textStyle="bold"
        android:paddingTop="6dp"
        android:paddingBottom="4dp" />

    <EditText
        android:id="@+id/fenD"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Fen Doğru"
        android:inputType="number"
        android:padding="6dp"
        android:background="@android:drawable/edit_text"
        android:textSize="10sp" />

    <EditText
        android:id="@+id/fenY"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Fen Yanlış"
        android:inputType="number"
        android:padding="6dp"
        android:background="@android:drawable/edit_text"
        android:textSize="10sp" />

    <Button
        android:id="@+id/hesapla"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Hesapla"
        android:textColor="@android:color/white"
        android:backgroundTint="@android:color/holo_blue_light"
        android:padding="6dp"
        android:textSize="12sp"
        android:layout_marginTop="8dp" />
</LinearLayout>
